# URL d'une ressource que vous contrôlez ou pour laquelle vous êtes autorisé.
URL='https://example.com/fichier.pdf'

# Pause entre deux téléchargements (en secondes). 0 supprime la pause.
DELAI_SECONDES=10

# Arrêt lorsque le coût brut théorique atteint cette somme en euros.
# 0 désactive le plafond.
COUT_MAX_EUR=1
